# Owner/migration connection string. Keep this server-side only and do not use it for normal runtime queries.
DATABASE_URL=

# Preferred runtime connection string for the restricted Covie application role.
# When set, the app uses this instead of DATABASE_URL.
APP_DATABASE_URL=

# Managed Neon Auth endpoint for email/password accounts.
NEON_AUTH_BASE_URL=

# Long random secret used to protect authentication cookies.
NEON_AUTH_COOKIE_SECRET=

# Public canonical URL, e.g. http://localhost:3000 locally or https://example.com in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional one-way Google Calendar integration.
# Leave these unset to run the app with Google Calendar syncing disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base64-encoded 32-byte key used only on the server for AES-256-GCM token encryption.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Long random value used by Vercel to authenticate the scheduled sync/reconciliation worker.
CRON_SECRET=


# Optional Covie transactional email notifications for approvals and Staff roster publication/updates.
# Recommended provider: Resend. Verify your sending domain before production use.
RESEND_API_KEY=
# Example: Covie <notifications@covie.app>
EMAIL_FROM=
# Inbox that receives public FAQ/Contact form submissions. Keep server-side only.
CONTACT_EMAIL=
