# Neon Postgres connection string. Keep this server-side only.
DATABASE_URL=

# Used to validate legacy calendar links during account migration.
APP_SECRET=

# Managed Neon Auth endpoint for email/password accounts.
NEON_AUTH_BASE_URL=

# Long random secret used to protect authentication cookies.
NEON_AUTH_COOKIE_SECRET=

# Public canonical URL, e.g. http://localhost:3000 locally or https://example.com in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
